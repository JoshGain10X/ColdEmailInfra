# Overrides for docker-mailserver's Dovecot configuration.
# Loaded via /tmp/docker-mailserver/dovecot.cf inside the container.

# Left at the DMS-safe baseline; the services that actually need headroom are
# given explicit limits below rather than inflating every service.
default_process_limit = 500

# Default is 10 per user per IP. Bison may open multiple IMAP
# connections per mailbox from the same server IP.
mail_max_userip_connections = 50

# service imap needs one process per authenticated session. A 100-mailbox shard
# runs ~400 concurrent IMAP sessions (Bison polling plus Instantly warmup), not
# the ~100 assumed when this file was first written. Dovecot's compiled-in
# default for this service is already 1024, so this was never the binding limit
# - raised only for headroom as mailbox counts grow.
service imap {
  process_limit = 1200
}

# THIS is the limit that actually bit us. imap-login runs in high-security mode
# by default (service_count = 1), forking one login process per connection and
# inheriting default_process_limit. A 100-mailbox shard holds ~400 concurrent
# sessions, so it sat at 400/500 - 80% of the ceiling - and burst over it
# 25-40 times per shard per week:
#   "service(imap-login): process_limit (500) reached, connections are dropped"
# High-performance mode lets a handful of login processes carry every
# connection, which removes the ceiling rather than just raising it.
# Measured on evolve10xleaders.com: 402 -> 15 login processes, ~275MB RAM and
# ~320MB swap returned. (Note: this was NOT the cause of the 2026-08-15/17
# "ingestion stall" alerts - those were a monitor sampling bug. This is a real
# but separate latent defect.)
service imap-login {
  service_count = 0
  client_limit = 1000
  process_min_avail = 4
  process_limit = 64
  vsz_limit = 512M
}

# auth/anvil must be able to serve the summed process_limits of the protocol
# services above, or Dovecot warns and can stall logins under load.
service auth {
  client_limit = 2000
}

service anvil {
  client_limit = 2000
}
