OVERRIDE_HOSTNAME=__MAIL_HOSTNAME__

SMTP_ONLY=0
SSL_TYPE=self-signed

PERMIT_DOCKER=none
TLS_LEVEL=modern
SPOOF_PROTECTION=1

ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1
ENABLE_RSPAMD=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1

POSTMASTER_ADDRESS=postmaster@__MAIL_HOSTNAME__

POSTFIX_MESSAGE_SIZE_LIMIT=26214400
POSTFIX_MAILBOX_SIZE_LIMIT=0

ENABLE_MANAGESIEVE=0
ENABLE_POSTGREY=0

LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=warn
