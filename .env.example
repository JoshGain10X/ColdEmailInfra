# Cloudflare account-scoped API token (works across every zone you ever add)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Contabo — provisions the VPS per shard (OAuth2 password grant)
# Get these from https://new.contabo.com/account/security
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# Default VPS spec (can be overridden via CLI flags)
# V45 = Cloud VPS 10 (4GB RAM / 2 vCPU / 50GB NVMe / ~€4.99/mo)
CONTABO_PRODUCT_ID=V45
# Regions: EU, US-central, US-east, US-west, SIN, UK
CONTABO_REGION=EU
# Ubuntu 22.04 LTS standard image
CONTABO_IMAGE_ID=d64d5c6c-9dda-4e38-8174-0ee282474d8a

# Default behaviour of the deploy script
REDIRECT_TARGET=https://10xmanagers.com
DMARC_RUA=dmarc@10xmanagers.co.uk
LE_EMAIL=ops@10xmanagers.co.uk

# SSH keypair used to reach the provisioned VPS
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
