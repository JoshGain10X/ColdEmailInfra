# NOTE: This is the v1 (single-tenant) env template, kept for the
# v1 container at infra-api.10xmanagers.com. The v2 multi-tenant API
# resolves per-client credentials from Supabase — see .env.v2.example.

# Cloudflare account-scoped API token (works across every zone you ever add)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Webdock — provisions the VPS per shard.
# Billing: monthly prepaid, prorated on create, refunded per-day-unused on delete
# (card only — PayPal is non-refundable, so link a credit card in the dashboard
# before first deploy). Every new server has a 24h free-trial window, so any
# destroy inside the first 24h (our dirty-IP retry loop) costs €0.
# Generate a token at https://webdock.io/en/dash/account/apitokens (scoped, revokable).
WEBDOCK_API_TOKEN=
# Run `python3 scripts/webdock_discover.py` to list valid slugs for your account.
# Profile / location / image values below are placeholders — verify before first deploy.
# Defaults below target docker-mailserver (ClamAV disabled): 2 GB RAM,
# dedicated AMD EPYC core, 28 GB SSD, ~€4.30/mo. Denmark is Webdock's
# only location as of 2026. Re-verify with webdock_discover.py if these
# slugs 404 on provision.
WEBDOCK_PROFILE_SLUG=vps-epyc-advanced-2025
WEBDOCK_LOCATION_ID=dk
WEBDOCK_IMAGE_SLUG=webdock-ubuntu-jammy-cloud

# Default behaviour of the deploy script
REDIRECT_TARGET=https://10xmanagers.com
DMARC_RUA=dmarc@10xmanagers.co.uk
LE_EMAIL=ops@10xmanagers.co.uk

# SSH keypair used to reach the provisioned VPS
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# Email Bison — used by scripts/load_to_bison.py to push senders into a
# chosen workspace. Generate one API token per workspace from Bison's UI
# (Settings → API) and list them comma-separated below. Super-admin
# tokens work for listing workspaces but can't target one for writes,
# so the loader skips them.
BISON_API_BASE=https://send.spamproofed.com
BISON_API_TOKENS=
