# Cloudflare account-scoped API token (works across every zone you ever add)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Webdock — provisions the VPS per shard (pay-per-hour, credit refunded on destroy).
# Generate a token at https://webdock.io/en/dash/account/apitokens (scoped, revokable).
WEBDOCK_API_TOKEN=
# Run `python3 scripts/webdock_discover.py` to list valid slugs for your account.
# Profile / location / image values below are placeholders — verify before first deploy.
WEBDOCK_PROFILE_SLUG=webdocknano
WEBDOCK_LOCATION_ID=fi
WEBDOCK_IMAGE_SLUG=ubuntu-jammy-cloud

# Default behaviour of the deploy script
REDIRECT_TARGET=https://10xmanagers.com
DMARC_RUA=dmarc@10xmanagers.co.uk
LE_EMAIL=ops@10xmanagers.co.uk

# SSH keypair used to reach the provisioned VPS
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# Email Bison — used by scripts/load_to_bison.py to push senders into a
# chosen workspace. Generate one API token per workspace from Bison's UI
# (Settings → API) and list them comma-separated below. Super-admin
# tokens work for listing workspaces but can't target one for writes,
# so the loader skips them.
BISON_API_BASE=https://send.spamproofed.com
BISON_API_TOKENS=
