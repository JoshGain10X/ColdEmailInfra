# v2 (multi-tenant) API environment template.
# Copy to .env.v2 on the API VPS and fill in the values marked <REQUIRED>.
#
# Differences from the v1 .env:
#   - SUPABASE_URL/KEY point at the Cold Email Data project (jiwsuukvnaazwytrymjr)
#     rather than Commission Calculator. All per-client credentials
#     (Webdock, Cloudflare, Bison) come from there via Vault.
#   - Per-tenant globals (REDIRECT_TARGET, DMARC_RUA, LE_EMAIL,
#     CLOUDFLARE_API_TOKEN, WEBDOCK_API_TOKEN) are NOT set here — they
#     are resolved per-request from the client's record.

# API auth — generate any random hex string (32+ chars) and use it as the bearer
# token for callers (skill, CRM, curl). Different from v1 on purpose so the
# wrong caller can't accidentally hit the wrong container.
INFRA_API_KEY=<REQUIRED — generate with: openssl rand -hex 32>

# Cold Email Data Supabase project
SUPABASE_URL=https://jiwsuukvnaazwytrymjr.supabase.co
SUPABASE_SERVICE_KEY=<REQUIRED — copy from Supabase dashboard: Settings → API → service_role secret>

# Bison default (clients can override per workspace in client_bison_workspaces.base_url)
BISON_API_BASE=https://send.spamproofed.com

# SSH for the mailserver bootstrap. These are mounted from the host (~/.ssh)
# into /root/.ssh inside the container — same as v1.
SSH_PUBLIC_KEY_PATH=/root/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=/root/.ssh/id_ed25519

# Contabo (legacy fallback provider, kept for the rare deploy where
# provider=contabo is forced). Per-client Webdock makes this unused
# under normal multi-tenant flow.
CONTABO_PRODUCT_ID=V91
CONTABO_REGION=EU
CONTABO_IMAGE_ID=d64d5c6c-9dda-4e38-8174-0ee282474d8a

# CORS
CORS_ORIGINS=*

# Instantly API key (Bearer). Used at load-to-bison time to push new mailboxes
# into Instantly's warmup network. Same value as Commission Compass's
# INSTANTLY_API_KEY edge function secret.
INSTANTLY_API_KEY=<REQUIRED — copy from Commission Compass project: Edge Functions -> Secrets -> INSTANTLY_API_KEY>
